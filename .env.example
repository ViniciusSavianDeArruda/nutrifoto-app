# Variáveis do docker compose (lidas da raiz do projeto). Copie para .env: cp .env.example .env

POSTGRES_DB=nutrifoto

# --- Portas no seu computador (todas escutam só em 127.0.0.1) ---
DB_PORT=5432
# Se mudar WORKER_PORT, ajuste PUBLIC_API_URL em apps/worker/.dev.vars para a mesma porta.
WORKER_PORT=8787
WEB_PORT=5173
# Só para o front de produção (docker compose --profile prod up --build web-prod)
WEB_PROD_PORT=8080

# --- Build do front de produção (alvo "prod") ---
# E-mail de contato exibido nos Termos e na Privacidade. É público (vai para o JavaScript do navegador).
VITE_CONTACT_EMAIL=
